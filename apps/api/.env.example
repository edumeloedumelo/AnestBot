# ANESTBOT Platform API — variáveis de ambiente. NUNCA commitar valores reais.

DATABASE_URL=                     # postgres://user@host:5432/anestbot
PORT=4000
MIGRATE_ON_BOOT=0                 # 1 = aplica migrations pendentes no boot

# Inbox de eventos do bot (mesmo segredo do PLATFORM_EVENTS_SECRET do bot).
PLATFORM_EVENTS_SECRET=
PLATFORM_EVENTS_SECRET_PREVIOUS=  # rotação sem downtime (opcional)

# CORS explícito: origens permitidas separadas por vírgula. Vazio = nenhuma.
CORS_ORIGINS=

# Testes: aponte para um Postgres pronto (CI) — senão scripts/testdb.sh sobe
# um cluster efêmero local com initdb/pg_ctl.
DATABASE_URL_TEST=
