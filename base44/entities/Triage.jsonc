{
  "name": "Triage",
  "type": "object",
  "properties": {
    "patient_name": {
      "type": "string",
      "description": "Nome da paciente"
    },
    "surgery_type": {
      "type": "string",
      "description": "Tipo de cirurgia identificada"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete_without_alerts",
        "complete_with_alerts",
        "incomplete",
        "critical_pending"
      ],
      "description": "Status final da triagem"
    },
    "missing_exams": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Exames obrigat\u00f3rios faltantes"
    },
    "altered_exams": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Exames com altera\u00e7\u00f5es relevantes"
    },
    "relatorio_tecnico": {
      "type": "string",
      "description": "Relat\u00f3rio t\u00e9cnico completo"
    },
    "bloco_resumo": {
      "type": "string",
      "description": "Resumo para WhatsApp"
    },
    "files_count": {
      "type": "number",
      "description": "Quantidade de arquivos enviados"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais do m\u00e9dico"
    }
  },
  "required": [
    "patient_name",
    "surgery_type",
    "status"
  ]
}