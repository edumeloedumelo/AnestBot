# ANESTBOT — variáveis de ambiente (produção: Railway → Variables)
# NUNCA commitar valores reais. Este arquivo documenta apenas as chaves.

# ── Obrigatórias ────────────────────────────────────────────────────────────
ULTRAMSG_INSTANCE_ID=           # painel UltraMsg → Instance ID
ULTRAMSG_TOKEN=                 # painel UltraMsg → Token
ANTHROPIC_API_KEY=              # console.anthropic.com
STATE_DIR=/data                 # volume persistente montado no Railway
PORT=3000

# ── Segurança (Marco 0 — configure em produção) ─────────────────────────────
# Autenticação do webhook: gere um segredo forte (ex.: openssl rand -hex 32) e
# aponte o webhook do UltraMsg para  https://SEU-APP/webhook?token=ESTE_VALOR
# Sem esta env o bot aceita qualquer origem (modo compatibilidade, com aviso).
WEBHOOK_TOKEN=
# Números com permissão de admin, separados por vírgula (com ou sem DDI 55).
# VAZIO = fail-closed: só o número conectado à UltraMsg (fromMe) é admin.
ADMIN_NUMBERS=
# Habilita GET /diag?token=ESTE_VALOR (diagnóstico agregado, sem dados clínicos).
# Sem esta env o endpoint responde 404.
DIAG_TOKEN=
# Limite do corpo aceito no webhook (payload normal do UltraMsg tem poucos KB).
WEBHOOK_BODY_LIMIT=5mb

# ── Opcionais ───────────────────────────────────────────────────────────────
ALLOWED_CHATS=                  # ids de grupos permitidos (vazio = todos)
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096
TRIGGER_PREFIX=/
